{
  "name": "slack-grammar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "PSF-2.0",
  "description": "Local-only grammar & spelling checker for the Linux Slack desktop app",
  "scripts": {
    "dev": "bun run daemon/src/main.ts",
    "doctor": "bun run daemon/src/main.ts doctor",
    "lint": "biome check daemon eval",
    "format": "biome format --write daemon eval",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run eval/run.ts",
    "build:bundle": "esbuild bundle/src/main.ts --bundle --format=iife --target=chrome120 --outfile=bundle/dist/slack-grammar-bundle.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "smol-toml": "^1.3.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
