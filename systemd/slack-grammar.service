# slack-grammar daemon — systemd user unit template.
#
# scripts/install.sh generates ~/.config/systemd/user/slack-grammar.service
# from this layout with absolute paths. Manual use:
#   mkdir -p ~/.config/systemd/user
#   (adapt the ExecStart below to your bun + checkout paths)
#   systemctl --user daemon-reload && systemctl --user enable --now slack-grammar

[Unit]
Description=slack-grammar — local LLM grammar checker for Slack
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/slack-grammar start
Restart=on-failure
RestartSec=5
# Loopback-only networking is enforced by the app itself (127.0.0.1 binds).

[Install]
WantedBy=default.target
